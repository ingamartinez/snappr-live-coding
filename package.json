{
  "name": "snappr-live-coding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "pnpm install && pnpm db:up && pnpm migrate && pnpm seed",
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "pnpm --filter @snappr/server dev",
    "dev:client": "pnpm --filter @snappr/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && pnpm migrate && pnpm seed",
    "db:generate": "pnpm --filter @snappr/server db:generate",
    "migrate": "pnpm --filter @snappr/server migrate",
    "seed": "pnpm --filter @snappr/server seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1"
  }
}
